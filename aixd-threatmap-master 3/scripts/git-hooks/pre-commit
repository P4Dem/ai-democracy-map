#!/usr/bin/env bash
# AIxD Threat Map — pre-commit hook
# Runs the Visualization Style Gate ("De-Claude" guardrails) before every commit.
# A red gate aborts the commit. Skip deliberately with: git commit --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v bun >/dev/null 2>&1; then
  echo "[pre-commit] ERROR: bun not found. Install via: npm i -g bun" >&2
  exit 1
fi

echo "[pre-commit] running visualization style gate…"
bun run stylecheck

echo "[pre-commit] style gate PASS — commit allowed."