---
import "@/styles/globals.css";
import { AdminPanel } from "@/components/AdminPanel";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "");
const fontFaceCss = `
@font-face {
  font-family: 'Beatrice';
  src: url("${base}/fonts/Beatrice-Regular.otf") format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Beatrice';
  src: url("${base}/fonts/Beatrice-Bold.otf") format("opentype");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
`;
---

<style is:inline set:html={fontFaceCss} />

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin – AI–Democracy Map</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <main>
      <AdminPanel client:load />
    </main>
  </body>
</html>
