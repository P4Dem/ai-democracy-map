---
import "@/styles/globals.css";
import { ThreatMap } from "@/components/ThreatMap";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "");
const fontFaceCss = `
@font-face {
  font-family: 'Beatrice';
  src: url("${base}/fonts/Beatrice-Regular.otf") format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Beatrice';
  src: url("${base}/fonts/Beatrice-Bold.otf") format("opentype");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Beatrice';
  src: url("${base}/fonts/Beatrice-RegularItalic.otf") format("opentype");
  font-weight: 400;
  font-style: italic;
  font-display: swap;
}
`;
---

<style is:inline set:html={fontFaceCss} />

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Democracy Map V2.0</title>
    <meta
      name="description"
      content="Explore how AI intersects with democratic institutions – threats, mitigation strategies, and opportunities mapped to the IDEA Democracy Assessment Framework."
    />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    <!-- Open Graph / social preview -->
    <meta property="og:title" content="AI Democracy Map V2.0" />
    <meta property="og:description" content="Explore how AI intersects with democratic institutions – threats, mitigation strategies, and opportunities mapped to the IDEA Democracy Assessment Framework." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Font preloads (prevent Beatrice flash) -->
    <link rel="preload" href={`${base}/fonts/Beatrice-Regular.otf`} as="font" type="font/otf" crossorigin />
    <link rel="preload" href={`${base}/fonts/Beatrice-Bold.otf`} as="font" type="font/otf" crossorigin />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <main>
      <ThreatMap client:load />
    </main>
  </body>
</html>
